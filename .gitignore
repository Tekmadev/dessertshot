# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.next.old/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# Owner's original phone photos: they carry GPS EXIF (home location) and
# this repo is public. Only metadata-stripped derivatives go in public/.
/source-photos/

# The private project brief (business details not meant for a public repo)
/dessertshot-cc-prompt.md

# Drafts that stay private until the owner approves publishing them
# (the repo is public)
/content/private/

# vercel
.vercel

# local dev helpers
start-dev.command
_push.command
_push.log
.claude/

# typescript
*.tsbuildinfo
next-env.d.ts
